# Copie este arquivo para .env.local e preencha.
# NEXT_PUBLIC_ = o valor vai para o navegador. Isso é OK para estas variáveis:
# a chave "publishable" é pública; quem protege os dados é o RLS.
# NUNCA coloque aqui a chave "secret" / "service_role".

# --- Desenvolvimento (Supabase local no Docker) ---
# Depois de "npm run db:start", rode "npx supabase status" e copie:
#   URL           -> "Project URL" (normalmente http://127.0.0.1:54321)
#   Chave         -> "Publishable" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do site, sem "/" no final. Vai no link do e-mail de confirmação.
# Local: http://localhost:3000   |   Produção: o domínio do site (ticket 12)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
